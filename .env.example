# ============================================================
#  VaaniKhata – Environment Variables (EXAMPLE)
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit .env to version control.
# ============================================================

# ── Gnani API Credentials ───────────────────────────────────
GNANI_API_KEY=PASTE_YOUR_GNANI_API_KEY_HERE
GNANI_DEV_MODE=false

# ── Database & Encryption (DPDP Compliance) ─────────────────
DB_PATH=vaanikhata.db
# ENCRYPTION_KEY=          # Leave empty to auto-generate .fernet.key

# ── STT (Prisma v3.0) overrides (optional) ──────────────────
# STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
# STT_MODEL=prisma-v3.0
# STT_LANGUAGE=hi-IN
# STT_SAMPLE_RATE=16000
# STT_FORMAT=transcribe

# ── TTS (Timbre v3.0) overrides (optional) ──────────────────
# TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
# TTS_MODEL=timbre-v3.0
# TTS_VOICE=Avinash
# TTS_LANGUAGE=hi-IN
# TTS_SPEED=1.0
# TTS_SAMPLE_RATE=16000
# TTS_ENCODING=linear_pcm
# TTS_CONTAINER=wav
